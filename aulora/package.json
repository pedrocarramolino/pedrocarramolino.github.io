{
  "name": "aulora",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "TZ=Europe/Madrid vitest run",
    "e2e": "firebase emulators:exec --only auth,firestore --project demo-aulora 'node e2e/run.mjs'",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-aulora",
    "rules:test": "firebase emulators:exec --only firestore --project demo-aulora 'node e2e/rules-test.mjs'",
    "e2e:build": "node e2e/build.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.106.1",
    "date-fns": "^4.4.0",
    "firebase": "^13.2.0",
    "geist": "^1.9.2",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase-tools": "^15.35.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
