# Configuración para compilar la app contra los emuladores locales de Firebase (pruebas E2E).
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-aulora.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-aulora
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo
NEXT_PUBLIC_FIREBASE_EMULATORS=1
