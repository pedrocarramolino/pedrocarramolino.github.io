rules_version = '2';

// =============================================================================
// Aulora · Reglas de seguridad de Cloud Firestore
//
// Todos los datos de un profesor viven bajo users/{uid}/…  y solo ese usuario
// autenticado puede leerlos o modificarlos. Cualquier otra ruta está cerrada.
// Además se validan los campos esenciales de cada tipo de documento.
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function optStr(v, max) {
      return v == null || (v is string && v.size() <= max);
    }
    function minutes(v) {
      return v is int && v >= 5 && v <= 600;
    }
    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function optDate(v) {
      return v == null || isDate(v);
    }
    function isInstant(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$');
    }
    function oneTarget(d) {
      return (d.student_id is string && d.group_id == null) || (d.group_id is string && d.student_id == null);
    }

    // ---------------------------------------------------------------- Perfil
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && optStr(request.resource.data.display_name, 120)
        && request.resource.data.day_start_hour is int
        && request.resource.data.day_end_hour is int
        && request.resource.data.day_start_hour >= 0
        && request.resource.data.day_end_hour <= 24
        && request.resource.data.day_end_hour > request.resource.data.day_start_hour
        && minutes(request.resource.data.default_lesson_minutes);

      // --------------------------------------------------------- Categorías
      match /categories/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && str(request.resource.data.name, 1, 60);
      }

      // ------------------------------------------------------------ Alumnos
      match /students/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && str(request.resource.data.first_name, 1, 80)
          && request.resource.data.status in ['active', 'inactive', 'archived']
          && minutes(request.resource.data.lesson_minutes)
          && request.resource.data.group_ids is list
          && optStr(request.resource.data.photo, 200000)
          && optDate(request.resource.data.joined_on);
      }

      // ------------------------------------------------------------- Grupos
      match /groups/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && str(request.resource.data.name, 1, 120)
          && minutes(request.resource.data.lesson_minutes)
          && request.resource.data.archived is bool;
      }

      // ----------------------------------------------- Series y clases
      match /series/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && oneTarget(request.resource.data)
          && request.resource.data.weekdays is list
          && request.resource.data.weekdays.size() >= 1
          && minutes(request.resource.data.duration_minutes)
          && isDate(request.resource.data.start_date)
          && isDate(request.resource.data.end_date);
      }
      match /lessons/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && oneTarget(request.resource.data)
          && isInstant(request.resource.data.starts_at)
          && isInstant(request.resource.data.ends_at)
          && minutes(request.resource.data.duration_minutes)
          && request.resource.data.status in ['scheduled', 'completed', 'cancelled'];
      }

      // ------------------------------------------------------------- Tareas
      match /tasks/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && str(request.resource.data.title, 1, 200)
          && isDate(request.resource.data.week_start)
          && request.resource.data.priority in ['low', 'normal', 'high']
          && request.resource.data.student_ids is list
          && request.resource.data.assignments is map
          && optDate(request.resource.data.due_on);
      }

      // -------------------------------------------------------- Seguimiento
      match /notes/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.student_id is string
          && str(request.resource.data.body, 1, 5000)
          && request.resource.data.kind in ['observation', 'achievement', 'difficulty', 'improvement'];
      }
      match /goals/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.student_id is string
          && str(request.resource.data.title, 1, 200)
          && request.resource.data.status in ['active', 'achieved', 'dropped'];
      }

      // ------------------------------------------- Registro de actividad
      match /activity/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.action in ['created', 'updated', 'deleted']
          && str(request.resource.data.label, 0, 200);
        allow update: if false;
      }
    }

    // Todo lo demás está cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
